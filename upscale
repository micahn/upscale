#!/usr/bin/env bash
# upscale - local AI image upscaler (Real-ESRGAN + Vulkan).
# Sandbox: everything lives under $UPSCALE_HOME (default ~/.local/share/upscale).
set -euo pipefail

TOOL="github:xinntao/Real-ESRGAN@0.2.5.0"
ROOT="${UPSCALE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/upscale}"
MODEL="${UPSCALE_MODEL:-realesr-animevideov3}"
MAX_EDGE=16384   # largest width or height to attempt; beyond this is a typo or a joke

export MISE_DATA_DIR="$ROOT/mise/data"
export MISE_CONFIG_DIR="$ROOT/mise/config"
export MISE_STATE_DIR="$ROOT/mise/state"
export MISE_CACHE_DIR="$ROOT/mise/cache"

die() { printf 'upscale: %s\n' "$*" >&2; exit 1; }

# Per-run scratch directory for model intermediates. Deliberately not next to
# the input: that breaks read-only source directories, litters the user's photo
# folder when a run dies, and can clobber a file that already exists there.
WORK=""

cleanup() {
  [[ -n $WORK && -d $WORK ]] && rm -rf "$WORK"
  WORK=""
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

new_workdir() {
  WORK=$(mktemp -d "${TMPDIR:-/tmp}/upscale.XXXXXXXX") \
    || die "cannot create a temp directory (check TMPDIR=${TMPDIR:-/tmp})"
  chmod 700 "$WORK"
}

# "4K", "2k_uw", "4K-UW", "800x600" -> "W H"
target_size() {
  local k="${1,,}"; k="${k//[-_]/}"
  case "$k" in
    720)        echo "1280 720"   ;; 720uw)   echo "1680 720"    ;;
    1080)       echo "1920 1080"  ;; 1080uw)  echo "2560 1080"   ;;
    1440|2k)    echo "2560 1440"  ;; 1440uw|2kuw) echo "3440 1440" ;;
    4k)         echo "3840 2160"  ;; 4kuw)    echo "5120 2160"   ;;
    8k)         echo "7680 4320"  ;; 8kuw)    echo "7680 3240"   ;;
    *x*)
      [[ $k =~ ^([1-9][0-9]*)x([1-9][0-9]*)$ ]] && echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}" || return 1 ;;
    *) return 1 ;;
  esac
}

# Real-ESRGAN only does whole 2x/3x/4x. Pick the smallest that covers the target
# (overshoot + lanczos beats stretching), or 1 if the source is already big enough.
pick_scale() {
  local sw=$1 sh=$2 tw=$3 th=$4 c
  if (( sw >= tw && sh >= th )); then echo 1; return; fi
  for c in 2 3 4; do
    if (( sw * c >= tw && sh * c >= th )); then echo "$c"; return; fi
  done
  echo 4
}

# Real-ESRGAN tops out at 4x. If even 4x misses the target, the shortfall is
# made up by ImageMagick, which is an ordinary interpolation with none of the
# detail the model exists to add. True when that is the case.
model_undershoots() {
  local sw=$1 sh=$2 tw=$3 th=$4
  (( sw * 4 < tw || sh * 4 < th ))
}

# How much the final resize enlarges by, as a whole percentage, for a source at
# sw x sh aiming at tw x th with the model clamped at 4x.
blowup_pct() {
  local sw=$1 sh=$2 tw=$3 th=$4 w h
  w=$(( tw * 100 / (sw * 4) ))
  h=$(( th * 100 / (sh * 4) ))
  (( w > h )) && echo "$w" || echo "$h"
}

ensure_tool() {
  command -v mise >/dev/null || die "mise not found (https://mise.jdx.dev)"
  command -v magick >/dev/null || die "ImageMagick 7 not found (pacman -S imagemagick)"
  local d
  d=$(mise where "$TOOL" 2>/dev/null) \
    || { echo "upscale: installing Real-ESRGAN (one time, ~47MB)..." >&2
         mise use -g "$TOOL" >&2 || die "install failed"
         d=$(mise where "$TOOL" 2>/dev/null) || die "install failed"; }
  # mise extracts the zip without the exec bit
  [[ -x "$d/realesrgan-ncnn-vulkan" ]] || chmod +x "$d/realesrgan-ncnn-vulkan" 2>/dev/null
  [[ -x "$d/realesrgan-ncnn-vulkan" ]] || die "realesrgan-ncnn-vulkan not runnable at $d"
  printf '%s' "$d/realesrgan-ncnn-vulkan"
}

# String-only checks on a candidate sandbox root: non-empty, not /, not $HOME,
# and deep enough that we are not looking at a stray top-level directory.
root_path_ok() {
  local r=$1 slashes
  [[ -n $r ]] || return 1
  r=${r%/}
  case "$r" in
    /|"$HOME") return 1 ;;
  esac
  slashes=$(printf %s "$r" | tr -cd '/' | wc -c)
  (( slashes >= 2 ))
}

# root_is_safe additionally requires the sandbox marker, so we only ever remove
# a directory this tool actually built. $ROOT comes straight from UPSCALE_HOME,
# so an inherited or mistyped value must not become an arbitrary `rm -rf`.
root_is_safe() {
  root_path_ok "$1" && [[ -d "$1/mise" ]]
}

# Remove the launcher we were invoked as, but only when that is safe: a file
# named "upscale" in a bin directory, matching the one on PATH. A git checkout
# or a dotfiles repo is left alone.
remove_launcher() {
  local force=$1 me=${0:-} onpath
  if [[ ! -f $me ]]; then
    printf 'upscale: no launcher at %s, nothing to remove there.\n' "${me:-<unknown>}" >&2
  elif [[ ${me##*/} != upscale ]]; then
    printf 'upscale: leaving %s alone (not named "upscale").\n' "$me" >&2
  else
    onpath=$(command -v upscale 2>/dev/null || :)
    if [[ -n $onpath && $onpath != "$me" ]]; then
      printf 'upscale: leaving %s alone; the launcher on PATH is %s.\n' "$me" "$onpath" >&2
    elif [[ $force -ne 1 && $me != */bin/upscale ]]; then
      printf 'upscale: leaving %s alone (not in a bin directory). Pass --all to remove it anyway.\n' "$me" >&2
    else
      rm -f "$me"
      printf 'upscale: removed launcher %s\n' "$me" >&2
    fi
  fi
}

do_uninstall() {
  local assume_yes=$1 force=$2 reply
  if [[ -e $ROOT || -L $ROOT ]]; then
    root_is_safe "$ROOT" \
      || die "refusing to remove '$ROOT': it does not look like the upscale sandbox.
  Only a directory with a mise/ inside it, at least two levels deep, and
  neither / nor \$HOME, is removed. If UPSCALE_HOME is set, unset it and retry."
    if (( assume_yes )); then
      printf 'upscale: removing %s\n' "$ROOT" >&2
    else
      printf 'about to remove %s\n' "$ROOT" >&2
      # /dev/tty exists but fails to open when there is no controlling terminal,
      # so the shell's own redirection error is suppressed and we report our own.
      read -r -p 'proceed? [y/N] ' reply 2>/dev/null < /dev/tty \
        || die "could not confirm (no tty); re-run with -y to skip the prompt"
      case "${reply,,}" in y|yes) ;; *) die "aborted" ;; esac
    fi
    rm -rf "$ROOT"
    printf 'upscale: removed sandbox %s\n' "$ROOT" >&2
  else
    printf 'upscale: no sandbox at %s\n' "$ROOT" >&2
  fi
  remove_launcher "$force"
  printf 'upscale: uninstall complete.\n' >&2
}

# True when a target is within MAX_EDGE on both axes. Beyond that it is a typo
# or a joke, and attempting it would hang or OOM the GPU.
edge_ok() {
  (( $1 <= MAX_EDGE && $2 <= MAX_EDGE ))
}

# The [0] here is an ImageMagick frame selector, not a bash array index. It
# lives in a function so selftest can cover the expansion: written inline as
# ${f[0]} bash reads it as an array index and deletes the selector, which is
# invisible on a single-frame JPEG and silently breaks animated input.
frame0() { printf '%s[0]' "$1"; }

usage() {
  cat <<EOF
upscale - local AI image upscaler

  upscale <size> <file...> [options]

size    720 1080 1440 2K 4K 8K   (16:9)
        720UW 1080UW 1440UW 2KUW 4KUW 8KUW   (ultrawide)
        WxH   exact, e.g. 800x600   (case-insensitive, - and _ ok)

options
  -o PATH   output file, or directory when several inputs
  -m NAME   realesr model (default: $MODEL)
  -f FMT    output format: png jpg webp tiff (default: png)
  -q N      encoder quality, 1-100 (lossy formats)
  -g ID     GPU device id, as seen by the Vulkan loader (default: auto)
  -t SIZE   tile size in pixels; lower it to fit large images
  -x        test-time augmentation: slower, slightly sharper
  -j N      run N files at once (default: 2; VRAM, not cores, is the limit)
  -y        proceed even when the source is too small to reach the target
  selftest  check the size/scale logic, no GPU needed
  uninstall remove the sandbox, and the launcher if it looks installed
          -y, --yes  skip the confirmation prompt
          --all      remove the launcher even outside a bin directory
EOF
}

selftest() {
  local f=0
  # The process_one assertions below go through magick. Without it every input
  # fails, and all of them expect a failure, so they would pass for the wrong
  # reason -- a green run that checked nothing. Require it up front.
  command -v magick >/dev/null \
    || die "selftest needs magick (ImageMagick); without it the process_one checks pass vacuously"
  check() { if [[ "$2" != "$3" ]]; then printf 'FAIL %s: got "%s" want "%s"\n' "$1" "$2" "$3"; f=1; fi; }
  check 4k        "$(target_size 4K)"        "3840 2160"
  check 4k-low    "$(target_size 4k)"        "3840 2160"
  check 4kuw      "$(target_size 4kUW)"      "5120 2160"
  check 4k-dash   "$(target_size 4K-UW)"     "5120 2160"
  check 2k        "$(target_size 2K)"        "2560 1440"
  check 1080uw    "$(target_size 1080uw)"    "2560 1080"
  check exact     "$(target_size 800x600)"   "800 600"
  check exact-bad "$(target_size 800)"       ""
  check bogus     "$(target_size 4kQ)"       ""
  check s-1       "$(pick_scale 4000 3000 1920 1080)" "1"
  check s-2       "$(pick_scale 960 540 1920 1080)"   "2"
  check s-3-exact "$(pick_scale 640 360 1920 1080)"   "3"
  check s-4       "$(pick_scale 200 120 800 480)"     "4"
  check s-4-max   "$(pick_scale 100 100 8000 8000)"   "4"
  check s-3       "$(pick_scale 400 300 1200 900)"    "3"
  # The cases above are all decided by the width alone. These three are not:
  # the width is met early but the height is not, so dropping `sh * c` from
  # pick_scale changes the answer. They are the only coverage of that clause.
  check s-h-short  "$(pick_scale 1920 200 1920 1080)" "4"
  check s-h-short2 "$(pick_scale 1000 300 1200 1000)" "4"
  check s-h-exact  "$(pick_scale 1920 1080 1920 1080)" "1"
  # ...and these three are decided by the height alone, covering `sw * c`.
  check s-w-narrow  "$(pick_scale 200 1080 1920 1080)" "4"
  check s-w-narrow2 "$(pick_scale 300 1000 1200 1000)" "4"
  check s-w-tall    "$(pick_scale 1080 1920 1920 1080)" "2"
  # uninstall safety: the guard must only accept a real, deep sandbox
  local sandbox
  sandbox=$(mktemp -d) || die "selftest: mktemp failed"
  mkdir -p "$sandbox/a/b/mise"
  check r-marker  "$(root_is_safe "$sandbox/a/b"; echo $?)"  "0"
  check r-nomise  "$(root_is_safe "$sandbox/a"; echo $?)"    "1"
  check r-empty   "$(root_is_safe ""; echo $?)"              "1"
  # string checks, testable without touching the filesystem
  check p-deep    "$(root_path_ok /tmp/upscale; echo $?)"     "0"
  check p-abs     "$(root_path_ok "$sandbox/a/b"; echo $?)"   "0"
  check p-top     "$(root_path_ok /upscale; echo $?)"         "1"
  check p-rel     "$(root_path_ok upscale; echo $?)"          "1"
  check p-slash   "$(root_path_ok /; echo $?)"                "1"
  check p-home    "$(root_path_ok "$HOME"; echo $?)"          "1"
  check p-empty   "$(root_path_ok ""; echo $?)"               "1"
  check p-trailing "$(root_path_ok "$sandbox/a/b/"; echo $?)" "0"
  # scratch dir lifecycle: created, private, removable, and never beside the input
  new_workdir
  check w-set     "$([[ -n $WORK && -d $WORK ]] && echo yes)" "yes"
  check w-mode    "$(stat -c %a "$WORK")"                     "700"
  check w-tmp     "$([[ $WORK == "${TMPDIR:-/tmp}"/upscale.* ]] && echo yes)" "yes"
  check w-clean   "$(rm -rf "$WORK"; [[ ! -e $WORK ]] && echo yes)" "yes"
  cleanup
  check w-cleared "$([[ -z $WORK ]] && echo yes)"            "yes"
  # process_one must report failure, not exit, so a batch can continue
  new_workdir
  printf 'not an image' > "$sandbox/broken"
  check po-missing "$(process_one "$sandbox/nope" "$sandbox/o.png" 100 100 /bin/false m 1 0 "" 0 0 "" /nonexistent >/dev/null 2>&1; echo $?)" "1"
  check po-broken  "$(process_one "$sandbox/broken" "$sandbox/o.png" 100 100 /bin/false m 1 0 "" 0 0 "" /nonexistent >/dev/null 2>&1; echo $?)" "1"
  check po-nodir   "$(process_one "$sandbox/a/b/mise" "$sandbox/o.png" 100 100 /bin/false m 1 0 "" 0 0 "" /nonexistent >/dev/null 2>&1; echo $?)" "1"
  check po-noinput "$(process_one "" "$sandbox/o.png" 100 100 /bin/false m 1 0 "" 0 0 "" /nonexistent >/dev/null 2>&1; echo $?)" "1"
  cleanup
  # out_path: the stem is a basename, and -o is a directory for batches
  check op-one-file  "$(out_path a/photo.png out.png 4K 1)"        "out.png"
  check op-one-dir   "$(out_path a/photo.png outdir 4K 1)"         "outdir"
  check op-many      "$(out_path a/photo.png outdir 4K 2)"         "outdir/photo-4k.png"
  check op-slash     "$(out_path a/photo.png outdir/ 4K 2)"        "outdir/photo-4k.png"
  check op-nested    "$(out_path x/y/z/p.png outdir 4K 2)"         "outdir/p-4k.png"
  check op-case      "$(out_path a/P.png outdir 4KUW 2)"           "outdir/P-4kuw.png"
  check op-dotfile   "$(out_path a/.prof outdir 4K 2)"             "outdir/.prof-4k.png"
  check op-noext     "$(out_path a/photo outdir 4K 2)"             "outdir/photo-4k.png"
  check op-multidot  "$(out_path a/b.c.png outdir 4K 2)"           "outdir/b.c-4k.png"
  check op-beside    "$(out_path a/photo.png "" 4K 1)"             "a/photo-4k.png"
  check op-beside-dot "$(out_path a/.prof "" 4K 1)"               "a/.prof-4k.png"
  # the bug: two dirs, same stem, one -o must collide rather than overwrite
  check op-clash1    "$(out_path a/photo.png o 4K 2)"              "o/photo-4k.png"
  check op-clash2    "$(out_path b/photo.png o 4K 2)"              "o/photo-4k.png"
  # The frame selector has to survive a filename that contains brackets itself.
  # ${f[0]} would delete the selector, which no single-frame test can see.
  check fr-plain     "$(frame0 photo.png)"         "photo.png[0]"
  check fr-bracket   "$(frame0 'shot[1].jpg')"      "shot[1].jpg[0]"
  check fr-odd       "$(frame0 'unbal[.jpg')"       "unbal[.jpg[0]"
  check fr-space     "$(frame0 'my photo.png')"    "my photo.png[0]"
  # -f changes the extension, and the collision check keys off the full path,
  # so a format cannot mask a clash
  check op-fmt-jpg   "$(out_path a/photo.png o 4K 2 jpg)"          "o/photo-4k.jpg"
  check op-fmt-webp  "$(out_path a/photo.png o 4K 2 webp)"         "o/photo-4k.webp"
  check op-fmt-beside "$(out_path a/photo.png "" 4K 1 jpg)"        "a/photo-4k.jpg"
  check op-fmt-clash "$(out_path a/photo.png o 4K 2 jpg)"          "$(out_path b/photo.png o 4K 2 jpg)"
  # only an identity orientation may be taken at face value; a rotated tag means
  # the stored grid is not what the user sees, and must not drive pick_scale
  check ex-identity  "$(needs_orient Undefined; echo $?)"           "1"
  check ex-top-left  "$(needs_orient TopLeft; echo $?)"             "1"
  check ex-rot-90    "$(needs_orient RightTop; echo $?)"            "0"
  check ex-rot-180   "$(needs_orient BottomRight; echo $?)"         "0"
  check ex-rot-270   "$(needs_orient LeftBottom; echo $?)"          "0"
  check ex-mirror    "$(needs_orient TopRight; echo $?)"            "0"
  # a source that cannot reach the target even at the 4x clamp
  check un-tiny      "$(model_undershoots 100 100 7680 4320; echo $?)" "0"
  check un-short-w   "$(model_undershoots 100 100 800 100; echo $?)"    "0"
  check un-short-h   "$(model_undershoots 1920 200 1920 1080; echo $?)" "0"
  check un-short-h2  "$(model_undershoots 1000 250 1000 2000; echo $?)" "0"
  check un-h-covers  "$(model_undershoots 1000 300 1200 1000; echo $?)" "1"
  check un-enough    "$(model_undershoots 1920 1080 3840 2160; echo $?)" "1"
  check un-generous  "$(model_undershoots 4000 3000 1920 1080; echo $?)" "1"
  # the size cap, which lives in edge_ok so it is reachable from here
  check edge-8k      "$(edge_ok 7680 4320; echo $?)"   "0"
  check edge-at-cap  "$(edge_ok 16384 16384; echo $?)" "0"
  check edge-over-w  "$(edge_ok 16385 4320; echo $?)"   "1"
  check edge-over-h  "$(edge_ok 7680 16385; echo $?)"   "1"
  check edge-absurd  "$(edge_ok 99999 99999; echo $?)"  "1"
  # and the percentage the final Lanczos step has to make up
  check bu-tiny-8k   "$(blowup_pct 100 100 7680 4320)"   "1920"
  check bu-short     "$(blowup_pct 100 100 400 100)"     "100"
  check bu-capped    "$(blowup_pct 1920 1080 7680 4320)" "100"
  check bu-both      "$(blowup_pct 400 300 1600 1200)"   "100"
  check bu-height    "$(blowup_pct 400 300 1600 6000)"   "500"
  check bu-width     "$(blowup_pct 400 300 6000 1200)"   "375"
  rm -rf "$sandbox"
  (( f )) && { echo "selftest: FAILED"; return 1; }
  echo "selftest: ok"
}

# Where does this input's output go? With -o and a single input, or when -o names
# an existing directory, -o is the destination; otherwise the output sits beside
# the input. The stem is the basename only -- using the whole path would mirror
# the input's directory tree inside -o, which is not what anyone expects.
out_path() {
  local f=$1 out=$2 spec=$3 nfiles=$4 fmt=${5:-png} stem
  if [[ -n $out ]] && (( nfiles == 1 )) && [[ ! -d $out ]]; then
    printf %s "$out"
    return
  fi
  local base; base=$(basename -- "$f")
  # Strip a trailing ".ext" from the basename, but not from a leading dot:
  # .profile is a whole name, not an extension on an empty stem.
  case "$base" in
    ?*.*) stem=${base%.*} ;;
    *)   stem=$base ;;
  esac
  if [[ -n $out ]]; then
    printf '%s/%s-%s.%s' "${out%/}" "$stem" "${spec,,}" "$fmt"
  else
    # beside the input: keep the directory, but the same stem rules apply
    printf '%s/%s-%s.%s' "$(dirname -- "$f")" "$stem" "${spec,,}" "$fmt"
  fi
}

# True when an EXIF orientation tag means the stored pixel grid is not the image
# the viewer shows. TopLeft is orientation 1, the identity; Undefined is no tag.
needs_orient() {
  [[ $1 != Undefined && $1 != TopLeft ]]
}

# The model names this build of realesrgan-ncnn-vulkan accepts. The animevideov3
# family ships as -x2/-x3/-x4 pairs, with the scale chosen by the binary.
list_models() {
  printf '%s ' realesr-animevideov3 realesrgan-x4plus \
    realesrgan-x4plus-anime realesrnet-x4plus
}

# Process one input file. Returns non-zero on failure so that a batch can carry
# on to the next file instead of aborting; the caller decides what to do about
# the overall exit status.
process_one() {
  local f=$1 o=$2 tw=$3 th=$4 bin=$5 model=$6 nth=$7 force=$8
  local gpu=$9 tile=${10} tta=${11} quality=${12} bindir=${13}
  local sw sh s tmp src dims_in orient frames

  [[ -f $f ]] || { printf 'upscale: no such file: %s  (did your glob match anything?)\n' "$f" >&2; return 1; }
  # The frame count has to come from the file without a [0] selector: selecting
  # frame 0 caps %n at 1, which is exactly the case worth detecting. identify
  # emits one value per frame, so they are space-separated and the first is
  # taken -- all frames of a GIF report the same count.
  local allframes
  if ! allframes=$(magick identify -format "%n " "$f" 2>/dev/null) || [[ -z ${allframes// /} ]]; then
    printf 'upscale: cannot read image: %s\n' "$f" >&2
    return 1
  fi
  frames=${allframes%% *}
  # One read gets the orientation tag and the stored grid. The trailing newline
  # is stripped by the command substitution.
  #
  # The [0] on the filename is an ImageMagick frame selector, not a bash array
  # index, and must be written as ${f}[0]. shellcheck's other suggestion,
  # ${f[0]}, makes bash eat the selector instead of passing it on -- a change
  # that is invisible for a single-frame JPEG and silently breaks animations.
  # frame0() exists so selftest can cover this; see the comment on it.
  if ! dims_in=$(magick identify -format "%[orientation] %w %h" "$(frame0 "$f")"); then
    printf 'upscale: cannot read image: %s\n' "$f" >&2
    return 1
  fi
  read -r orient sw sh <<<"$dims_in"

  # A phone photo is stored rotated with an EXIF orientation tag, so its stored
  # grid is not the image anyone sees: a 4032x3024 portrait is meant to display
  # as 3024x4032. Anything other than the identity needs the tag applied before
  # the dimensions are trusted, or the output comes out sideways.
  #
  # Multi-frame input is the same problem in a different form: the model is a
  # still-image model, and passing an animated file to it makes it exit 0
  # without writing anything, which surfaces as a confusing "failed to write".
  # So the first frame is extracted to a real single-frame file, which is what
  # gets scaled, and the user is told that is what happened.
  src="$f"
  if [[ $frames != 1 ]] || needs_orient "$orient"; then
    if [[ $frames != 1 ]]; then
      printf 'upscale: %s has %s frames; only the first is upscaled (no animation support)\n' \
        "$f" "$frames" >&2
    fi
    if ! magick "$(frame0 "$f")" -auto-orient "$WORK/$nth.frame.png"; then
      printf 'upscale: cannot read image: %s\n' "$f" >&2
      return 1
    fi
    src="$WORK/$nth.frame.png"
    if ! dims_in=$(magick identify -format "%w %h" "$src"); then
      printf 'upscale: cannot read image: %s\n' "$f" >&2
      return 1
    fi
    read -r sw sh <<<"$dims_in"
  fi

  s=$(pick_scale "$sw" "$sh" "$tw" "$th")
  # Say so when the model cannot get there and Lanczos does the rest, rather
  # than presenting a heavily interpolated result as an AI upscale.
  if model_undershoots "$sw" "$sh" "$tw" "$th"; then
    if (( force )); then
      printf 'upscale: %s: %sx%s is small for %sx%s, %s%% interpolated\n' \
        "$f" "$sw" "$sh" "$tw" "$th" "$(blowup_pct "$sw" "$sh" "$tw" "$th")" >&2
    else
      printf 'upscale: %s is only %sx%s; %sx%s is out of reach for the model,\n' "$f" "$sw" "$sh" "$tw" "$th" >&2
      printf '  so %s%% of the final size is plain interpolation, not model detail.\n' "$(blowup_pct "$sw" "$sh" "$tw" "$th")" >&2
      printf '  Pass --force if you want it anyway.\n' >&2
    fi
  fi
  mkdir -p "$(dirname "$o")" || { printf 'upscale: cannot create %s\n' "$(dirname "$o")" >&2; return 1; }

  if (( s == 1 )); then
    # source already covers the target: no model run, nothing to clean up.
    # Say so -- the tool is an AI upscaler, and silence here reads as a run
    # that did nothing.
    printf 'upscale: %s  %sx%s already covers %sx%s, resampling only (no model)\n' \
      "$f" "$sw" "$sh" "$tw" "$th" >&2
    tmp="$src"
  else
    # unique per file, so a batch cannot step on its own intermediates
    tmp="$WORK/$nth.x${s}.png"
    echo "upscale: $f  ${sw}x${sh} -> x${s} model -> ${tw}x${th}" >&2
    # GPU device, tile size and TTA are passed through only when asked for, so
    # the binary keeps its own defaults otherwise.
    # Only the four names this build of realesrgan-ncnn-vulkan documents work.
    # It must be checked here rather than left to the binary: given a name it
    # does not know, it prints a wall of fopen errors, exits 0, and writes an
    # image anyway -- an unpredictable result reported as success.
    case "$model" in
      realesr-animevideov3|realesrgan-x4plus|realesrgan-x4plus-anime|realesrnet-x4plus) ;;
      *)
        printf 'upscale: no such model: %s\n' "$model" >&2
        printf '  available: %s\n' "$(list_models "$bindir")" >&2
        return 1
        ;;
    esac
    local -a opts=(-i "$src" -o "$tmp" -s "$s" -n "$model")
    [[ -n $gpu ]] && opts+=(-g "$gpu")
    [[ $tile != 0 ]] && opts+=(-t "$tile")
    (( tta )) && opts+=(-x)
    if ! "$bin" "${opts[@]}" >&2; then
      printf 'upscale: model failed on %s\n' "$f" >&2
      return 1
    fi
  fi
  local -a mopts=("$tmp" -resize "${tw}x${th}^" -gravity center -extent "${tw}x${th}")
  [[ -n $quality ]] && mopts=(-quality "$quality" "${mopts[@]}")
  if ! magick "${mopts[@]}" "$o"; then
    printf 'upscale: failed to write %s\n' "$o" >&2
    return 1
  fi
  # only ever remove something we created inside the scratch dir
  if [[ $tmp == "$WORK"/* ]]; then rm -f "$tmp"; fi
  echo "upscale: wrote $o" >&2
  return 0
}

main() {
  case "${1:-}" in
    ""|-h|--help) usage; exit 0 ;;
    uninstall)
      shift
      local assume_yes=0 force=0
      while (( $# )); do
        case "$1" in
          -y|--yes)  assume_yes=1; shift ;;
          --all)     force=1; shift ;;
          -h|--help) usage; exit 0 ;;
          *) die "unknown option for uninstall: $1" ;;
        esac
      done
      do_uninstall "$assume_yes" "$force"
      exit 0 ;;
    selftest) selftest; exit $? ;;
  esac

  local spec="" out="" model="$MODEL" force=0 fmt=png quality=""
  local gpu="" tile=0 tta=0 jobs=${UPSCALE_JOBS:-2}
  local -a files=()
  while (( $# )); do
    case "$1" in
      -o|--out)   [[ $# -ge 2 ]] || die "$1 needs a value"; out=$2; shift 2 ;;
      -m|--model) [[ $# -ge 2 ]] || die "$1 needs a value"; model=$2; shift 2 ;;
      -f|--format) [[ $# -ge 2 ]] || die "$1 needs a value"; fmt=${2,,}; shift 2 ;;
      -q|--quality) [[ $# -ge 2 ]] || die "$1 needs a value"; quality=$2; shift 2 ;;
      -g|--gpu)   [[ $# -ge 2 ]] || die "$1 needs a value"; gpu=$2; shift 2 ;;
      -t|--tile)  [[ $# -ge 2 ]] || die "$1 needs a value"; tile=$2; shift 2 ;;
      -x|--tta)   tta=1; shift ;;
      -j|--jobs)  [[ $# -ge 2 ]] || die "$1 needs a value"; jobs=$2; shift 2 ;;
      -y|--force) force=1; shift ;;
      -h|--help)  usage; exit 0 ;;
      --) shift; files+=("$@"); break ;;
      -*) die "unknown option $1" ;;
      *)  if [[ -z $spec ]]; then spec=$1; else files+=("$1"); fi; shift ;;
    esac
  done

  case "$fmt" in
    png|jpg|jpeg|webp|tif|tiff) ;;
    *) die "unsupported format '$fmt' (try png, jpg, webp, tiff)" ;;
  esac
  [[ -z $quality || $quality =~ ^[0-9]+$ ]] || die "-q needs a number (1-100)"
  [[ $jobs =~ ^[0-9]+$ ]] || die "-j needs a number (1 or more)"
  (( jobs >= 1 )) || die "-j must be at least 1"
  # This build of the binary cannot load models from outside its own models/
  # directory, so a path is refused up front rather than silently ignored.
  if [[ $model == */* || $model == *.param || $model == *.bin ]]; then
    die "this realesrgan-ncnn-vulkan build cannot load a model from a path.
  Its -m option only accepts its own models/ directory, so only these work:
    $(list_models)
  Custom or fine-tuned weights would need a different build of the binary."
  fi

  [[ -n $spec ]] || die "no target size given (try: upscale 4K photo.png)"
  (( ${#files[@]} )) || die "no input files given"

  local dims
  dims=$(target_size "$spec") || die "unknown size '$spec' (try 1080, 4K, 4KUW, 800x600)"
  local tw th; read -r tw th <<<"$dims"
  if ! edge_ok "$tw" "$th"; then
    die "target ${tw}x${th} is larger than the ${MAX_EDGE}px limit on either axis
  (that is a typo, or a target the model cannot approach from any real photo).
  Use something up to ${MAX_EDGE}x${MAX_EDGE}."
  fi

  # Check every input before ensure_tool, so a typo or an empty glob expansion is
  # reported without first paying for a 47MB model download. Cheap checks here;
  # the expensive ones stay in process_one where they can be per-file.
  #
  # A partly-bad batch is still run, because dropping the good files is exactly
  # what the batch fix set out to stop. Only a wholly unusable argument list is
  # fatal here, and there is no point installing a model to discover that.
  local missing=()
  for f in "${files[@]}"; do
    [[ -f $f ]] || missing+=("$f")
  done
  if (( ${#missing[@]} == ${#files[@]} )); then
    printf 'upscale: no such file:\n' >&2
    printf '  %s\n' "${missing[@]}" >&2
    printf '  (did your glob match anything?)\n' >&2
    return 1
  elif (( ${#missing[@]} )); then
    printf 'upscale: %s of %s input(s) do not exist, continuing with the rest:\n' \
      "${#missing[@]}" "${#files[@]}" >&2
    printf '  %s\n' "${missing[@]}" >&2
  fi

  # The model is only needed if some input is actually smaller than its target.
  # On the scale-1 path it is never invoked, so a pure downscale should not pay
  # for a 47MB install. Dimensions are read exactly as process_one reads them --
  # displayed, not stored -- so this pre-scan cannot disagree with the decision
  # it is predicting. An unreadable file is left to process_one to report.
  local need_model=0 sw sh dims_probe
  for f in "${files[@]}"; do
    [[ -f $f ]] || continue
    dims_probe=$(magick identify -auto-orient -format "%w %h" "$(frame0 "$f")" 2>/dev/null) || continue
    read -r sw sh <<<"$dims_probe"
    (( sw >= tw && sh >= th )) || need_model=1
  done

  local bin="" bindir=""
  if (( need_model )); then
    bin=$(ensure_tool)
    bindir=$(dirname -- "$bin")
  fi

  new_workdir

  # Resolve every output path first. Two inputs mapping to one output would
  # silently overwrite each other, and that must be caught before any GPU time
  # is spent, not after the loser's result is already gone.
  local f o i=0 failed=0
  local -A seen_out=()
  local -a clashes=() outs=()
  for f in "${files[@]}"; do
    o=$(out_path "$f" "$out" "$spec" "${#files[@]}" "$fmt")
    if [[ -n ${seen_out[$o]:-} ]]; then
      clashes+=("$o  <-  ${seen_out[$o]} and $f")
    else
      seen_out[$o]=$f
    fi
    outs+=("$o")
  done
  if (( ${#clashes[@]} )); then
    printf 'upscale: two or more inputs resolve to the same output:\n' >&2
    printf '  %s\n' "${clashes[@]}" >&2
    printf '  Nothing was written. Rename them, or run them as separate batches.\n' >&2
    return 1
  fi

  # Every input is attempted, even if an earlier one failed: an unmatched glob
  # in the middle of a list should not cost the user the whole batch. The exit
  # status is still non-zero if anything failed, so scripts notice.
  #
  # Real-ESRGAN is a single-image model, so the parallelism is whole images
  # rather than a batched forward pass. The limit is VRAM, not cores: each
  # concurrent job holds a full working set, so -j is deliberately conservative
  # and -t is the lever if a job cannot fit.
  #
  # Each file writes to its own log, and a log is printed when its job finishes,
  # so concurrent output stays grouped per file instead of interleaving.
  local -A logof=()          # pid -> log file
  local -a live=()           # pids still running
  local running=0 finished
  i=0
  for f in "${files[@]}"; do
    i=$((i + 1))
    if (( running >= jobs )); then
      wait -n -p finished || failed=1
      running=$((running - 1))
      [[ -n $finished && -n ${logof[$finished]:-} ]] && cat "${logof[$finished]}" >&2
      unset "logof[$finished]"
    fi
    process_one "$f" "${outs[i-1]}" "$tw" "$th" "$bin" "$model" "$i" "$force" \
      "$gpu" "$tile" "$tta" "$quality" "$bindir" > "$WORK/log.$i" 2>&1 &
    logof[$!]="$WORK/log.$i"
    live+=("$!")
    running=$((running + 1))
  done
  # drain the rest, still in completion order
  for p in "${live[@]}"; do
    if wait "$p"; then :; else failed=1; fi
    [[ -n ${logof[$p]:-} ]] && cat "${logof[$p]}" >&2
  done

  if (( failed )); then
    printf 'upscale: finished with errors; some files were skipped (see above)\n' >&2
    return 1
  fi
  return 0
}

main "$@"
